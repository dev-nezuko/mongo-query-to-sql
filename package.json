{
  "name": "mongodb-to-sql-translator",
  "version": "1.0.0",
  "description": "Translate a safe subset of MongoDB find() queries into SQL text, as a library or CLI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mongo-to-sql": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npm run build && node examples/translate.cjs",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "keywords": [
    "mongodb",
    "sql",
    "translator",
    "typescript",
    "nodejs"
  ],
  "license": "ISC",
  "dependencies": {
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
