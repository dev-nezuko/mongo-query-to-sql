{
  "name": "mongodb-to-sql-translator",
  "version": "1.0.0",
  "description": "Limited MongoDB find-string to SQL-string translation exercise",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npm run build && node examples/translate.cjs",
    "lint": "eslint ."
  },
  "keywords": [
    "mongodb",
    "sql",
    "translator",
    "typescript",
    "nodejs"
  ],
  "license": "ISC",
  "dependencies": {
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
